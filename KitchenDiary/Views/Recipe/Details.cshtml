@model Recipe
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header">
    <h1>@Model.Title</h1>
    <p class="mb-0">Kategori: @ViewBag.CategoryName</p>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-7 mb-4">
            <img src="@Model.ImageUrl" class="detail-img" alt="@Model.Title"
                 onerror="this.src='https://placehold.co/800x500?text=Tarif'">
            <p class="mt-3 lead">@Model.Description</p>
        </div>

        <div class="col-lg-5 mb-4">
            <div class="info-box mb-4">
                <h5>Tarif Bilgileri</h5>
                <p class="mb-1">⏱ Hazırlık: @Model.PrepTime dk</p>
                <p class="mb-1">🔥 Pişirme: @Model.CookTime dk</p>
                <p class="mb-1">👥 @Model.Servings kişilik</p>
                <p class="mb-0">★ Puan: <span class="rating-badge">@Model.Rating</span></p>
            </div>

            <div class="info-box">
                <h5>Malzemeler</h5>
                <ul>
                    @foreach (var item in Model.Ingredients)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="info-box">
        <h5>Yapılışı</h5>
        <ol>
            @foreach (var step in Model.Steps)
            {
                <li class="mb-2">@step</li>
            }
        </ol>
    </div>

    <a asp-action="Index" class="btn btn-lezzet mt-4">← Tariflere Dön</a>
</div>