@model Recipe
@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <!-- Breadcrumb / Üst Yönlendirme -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="link-brand">Ana Sayfa</a></li>
            <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Index" class="link-brand">Kategoriler</a></li>
            <!--kategori ismi -->
            <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Details" asp-route-id="@Model.CategoryId" class="link-brand">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- Başlık Alanı (Sola kayma engellendi, hizalandı) -->
    <div class="mb-4">
        <h1 class="display-5 fw-bold text-dark mb-1">@Model.Title</h1>
    </div>

    <!-- Detay İçeriği -->
    <div class="row g-4">
        <!-- Sol Kolon: Görsel ve Açıklama -->
        <div class="col-lg-7">
            <div class="recipe-detail-img-container rounded-4 overflow-hidden shadow-sm mb-4">
                <img src="@Model.ImageUrl" alt="@Model.Title" class="recipe-detail-img"
                     onerror="this.src='https://images.unsplash.com/photo-1547592166-23ac45744acd?w=800&auto=format&fit=crop&q=80'">
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h4 class="fw-bold text-dark mb-3">📝 Tarif Hakkında</h4>
                <p class="text-muted leading-relaxed mb-0">@Model.Description</p>
            </div>
            <!-- Tarifin hazırlanışını -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                    👨‍🍳 Hazırlanışı
                </h5>

                @if (Model.Steps != null && Model.Steps.Any())
                {
                    <ul class="list-unstyled mb-0 step-list">
                        @foreach (var step in Model.Steps.OrderBy(s => s.StepNumber))
                        {
                            <li class="mb-2">
                                <strong>@step.StepNumber. adım:</strong> @step.Text
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0">
                        Hazırlanış adımı eklenmemiş.
                    </p>
                }
            </div>
        </div>

        <!-- Sağ Kolon: Bilgi Kutusu ve Malzemeler -->
        <div class="col-lg-5">
            <!-- Tarif Özet Bilgileri -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">⏱️ Tarif Bilgileri</h5>
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Hazırlık</small>
                            <span class="fw-bold text-dark fs-5">@Model.PrepTime dk</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Pişirme</small>
                            <span class="fw-bold text-dark fs-5">@Model.CookTime dk</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Porsiyon</small>
                            <span class="fw-bold text-dark fs-5">@Model.Servings kişilik</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded-3">
                            <small class="text-muted d-block mb-1">Puan</small>
                            <span class="fw-bold text-dark fs-5">★ @Model.Rating</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Malzemeler Kutusu -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">🛒 Malzemeler</h5>
                @if (Model.Ingredients != null && Model.Ingredients.Any())
                {
                    <ul class="list-unstyled mb-0 ingredient-list">
                        @foreach (var ing in Model.Ingredients)
                        {
                            <li class="py-2 border-bottom d-flex align-items-center gap-2">
                                <span class="text-success">✓</span> @ing.Text
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0">Malzeme bilgisi eklenmemiş.</p>
                }
            </div>
        </div>
    </div>
</div>