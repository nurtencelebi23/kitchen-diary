
@model List<Recipe>
@{
    ViewData["Title"] = "Tüm Tarifler";
}

<!-- Başlık ve Üst Bölüm -->
<section class="bg-light-custom py-5 mb-5 border-bottom">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill shadow-sm mb-2 border">
                    📖 Tarif Kütüphanesi
                </span>
                <h1 class="fw-bold mb-1">Tüm Tarifler</h1>
                <p class="text-muted mb-0">Toplam <strong>@Model.Count</strong> özel tarif keşfedilmeyi bekliyor</p>
            </div>
            
            <!-- Arama Kutusu (Görsel Zenginlik için) -->
            <div class="col-md-6">
                <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden bg-white border">
                    <span class="input-group-text bg-transparent border-0 pe-1 text-muted">🔍</span>
                    <input type="text" class="form-control border-0 fs-6 shadow-none" placeholder="Tarif veya malzeme ara...">
                    <button class="btn btn-primary-custom px-4" type="button">Ara</button>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container my-4">
    <div class="row g-4">
        @foreach (var r in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card recipe-card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <!-- Görsel Alanı ve Rozetler -->
                    <div class="position-relative">
                        <img src="@r.ImageUrl" class="card-img-top recipe-img" alt="@r.Title"
                             onerror="this.src='https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=800&auto=format&fit=crop&q=80'">
                        
                        <!-- Puan Rozeti -->
                        <span class="badge bg-white text-dark position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm fw-bold">
                            ★ @r.Rating
                        </span>
                        
                        <!-- Hazırlama Süresi Rozeti -->
                        <span class="badge bg-dark bg-opacity-75 text-white position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-pill">
                            ⏱ @(r.PrepTime + r.CookTime) dk
                        </span>
                    </div>

                    <!-- İçerik Alanı -->
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-dark mb-0 line-clamp-1">@r.Title</h5>
                        </div>
                        
                        <p class="card-text text-muted small flex-grow-1 line-clamp-2 mb-3">
                            @r.Description
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top text-muted small mb-3">
                            <span>👥 @r.Servings kişilik</span>
                            <span class="text-success fw-semibold">● Kolay</span>
                        </div>

                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-custom w-100 rounded-3">
                            Tarifi İncele →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>