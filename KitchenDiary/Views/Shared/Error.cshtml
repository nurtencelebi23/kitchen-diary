@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="container my-5 text-center">
    <div class="fs-1 mb-3">🍳💥</div>
    <h1 class="fw-bold text-dark mb-2">Bir şeyler ters gitti</h1>
    <p class="text-muted mb-4">İsteğiniz işlenirken bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Hata kodu: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-brand-primary">Ana Sayfaya Dön</a>
</div>