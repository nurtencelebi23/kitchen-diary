<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kitchen Diary</title>

    <!-- Bootstrap 5 ve Google Font -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm sticky-top py-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-dark fs-4" asp-controller="Home" asp-action="Index">
                    🍳 Kitchen Diary
                </a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Recipe" asp-action="Index">Tarifler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Category" asp-action="Index">Kategoriler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Home" asp-action="About">Hakkımızda</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer-lezzet text-center py-4 mt-5">
        <div class="container">
            <p class="mb-1 brand-font">🍲 Kitchen Diary</p>
            <small>&copy; @DateTime.Now.Year - İleri Web Programlama Dersi Projesi</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>