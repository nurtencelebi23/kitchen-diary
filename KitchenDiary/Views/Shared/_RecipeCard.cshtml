@model Recipe
<!-- PartialView -->
<div class="card recipe-card h-100 border-0 rounded-4 overflow-hidden shadow-sm">
    <div class="position-relative">
        <img src="@Model.ImageUrl" class="card-img-top recipe-img" alt="@Model.Title"
             onerror="this.src='https://images.unsplash.com/photo-1547592166-23ac45744acd?w=600&auto=format&fit=crop&q=80'">
        <span class="badge-rating position-absolute top-0 end-0 m-3">
            ★ @Model.Rating
        </span>
    </div>

    <div class="card-body d-flex flex-column p-4">
        <h5 class="card-title fw-bold text-dark mb-2">@Model.Title</h5>
        <p class="card-text text-muted small flex-grow-1 line-clamp-2">@Model.Description</p>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3 text-muted small">
            <span>⏱ @(Model.PrepTime + Model.CookTime) dk</span>
            <span>👥 @Model.Servings kişilik</span>
        </div>

        <a asp-controller="Recipe" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-brand-outline w-100 mt-3">
            Tarifi İncele
        </a>
    </div>
</div>