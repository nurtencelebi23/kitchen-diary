@model List<Recipe>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Modern Hero Section -->
<section class="hero-section py-5 mb-5">
    <div class="container py-lg-4">
        <div class="row align-items-center g-5">
            <!-- Sol Metin Alanı -->
            <div class="col-lg-6 text-center text-lg-start">
                <span class="hero-badge d-inline-block mb-3">
                    ✨ Binlerce Özel Yemek Tarifi
                </span>
                <h1 class="hero-title mb-3">
                    Bugün ne <span class="highlight-text">pişirsek?</span>
                </h1>
                <p class="hero-subtitle mb-4">
                    Ev yapımı en lezzetli tarifler, adım adım hazırlanış rehberleri ve lezzet sırları tek bir platformda.
                </p>
                <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                    <a asp-controller="Recipe" asp-action="Index" class="btn btn-brand-primary btn-lg px-4 shadow-sm">
                        Tarifleri Keşfet →
                    </a>
                </div>
            </div>

            <!-- Sağ Görsel Kart Alanı -->
            <div class="col-lg-6">
                <div class="hero-image-wrapper position-relative">
                    <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=800&auto=format&fit=crop&q=80"
                         alt="Günün Yemeği" class="img-fluid rounded-5 shadow-lg hero-main-img">
                    <div class="hero-floating-card shadow-lg rounded-4 p-3 d-flex align-items-center gap-3">
                        <span class="fs-2">⭐</span>
                        <div>
                            <div class="fw-bold text-dark">Günün Lezzeti</div>
                            <small class="text-muted">4.9/5 Puanlama</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <!-- Öne Çıkan Tarifler -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="section-title mb-1">Öne Çıkan Tarifler</h2>
            <p class="text-muted small mb-0">En çok denenen ve beğenilen lezzetler</p>
        </div>
        <a asp-controller="Recipe" asp-action="Index" class="link-brand fw-bold">
            Tümünü Gör →
        </a>
    </div>

    <div class="row g-4 mb-5">
        @foreach (var r in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <!-- PartialView -->
                <partial name="_RecipeCard" model="r" />
            </div>
        }
    </div>
</div>
<vc:category-list />