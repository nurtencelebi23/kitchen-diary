@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="page-header">
    <h1>Hakkımızda</h1>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="info-box">
                <h3>Lezzet Defteri Nedir?</h3>
                <p>Lezzet Defteri, yemek severlerin tariflerini paylaştığı, kategorilere göre keşfettiği ve favorilerine eklediği bir tarif platformudur.</p>
                <p>Bu proje, İleri Web Programlama dersi kapsamında ASP.NET Core MVC ile geliştirilmektedir ve her hafta yeni özelliklerle büyümektedir.</p>
                <h5 class="mt-4">Planlanan Özellikler</h5>
                <ul>
                    <li>Üyelik ve rol bazlı yetkilendirme</li>
                    <li>Tarif ekleme, düzenleme ve silme</li>
                    <li>Yorum ve favori sistemi</li>
                    <li>Admin yönetim paneli</li>
                </ul>
            </div>
        </div>
    </div>
</div>