@model List<Recipe>
@{
    var category = ViewBag.Category as Category;
    ViewData["Title"] = category?.Name ?? "Kategori Tarifleri";
}

<!-- Başlık Alanı (Ortalanmış ve Hizalanmış) -->
<section class="bg-light py-5 mb-5 border-bottom">
    <div class="container text-center">
        <!-- Üst Yönlendirme -->
        <nav aria-label="breadcrumb" class="d-inline-block mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="link-brand">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Category" asp-action="Index" class="link-brand">Kategoriler</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(category?.Name ?? "Tarifler")</li>
            </ol>
        </nav>

        <h1 class="display-5 fw-bold text-dark mb-2">@(category?.Name ?? "Kategori Tarifleri")</h1>
        <p class="text-muted mb-0 fs-5">@(category?.Description ?? "Bu kategoriye ait en lezzetli tarifler")</p>
    </div>
</section>

<!-- Tarif Listesi (Container İçinde) -->
<div class="container mb-5">
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <!-- PartialView -->
                    <partial name="_RecipeCard" model="r" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="fs-1 mb-3">🍲</div>
            <h4 class="fw-bold text-dark mb-2">Henüz bu kategoride tarif yok</h4>
            <p class="text-muted mb-4">Bu kategoriye ilk tarifi ekleyen sen olmak ister misin?</p>
            <a asp-controller="Recipe" asp-action="Index" class="btn btn-brand-primary">
                Diğer Tariflere Göz At
            </a>
        </div>
    }
</div>