@model List<Recipe>
@{
    var category = (Category)ViewBag.Category;
    ViewData["Title"] = category.Name;
}

<div class="page-header">
    <h1>@category.Name</h1>
    <p class="mb-0">@category.Description</p>
</div>

<div class="container my-5">
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var r in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card recipe-card h-100 shadow-sm">
                        <img src="@r.ImageUrl" class="card-img-top" alt="@r.Title"
                             onerror="this.src='https://placehold.co/600x400?text=Tarif'">
                        <div class="card-body">
                            <h5 class="card-title">@r.Title</h5>
                            <p class="text-muted small">@r.Description</p>
                            <a asp-controller="Recipe" asp-action="Details" asp-route-id="@r.Id" class="btn btn-lezzet">Tarife Git</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning">Bu kategoride henüz tarif yok.</div>
    }

    <a asp-action="Index" class="btn btn-lezzet mt-3">← Kategorilere Dön</a>
</div>