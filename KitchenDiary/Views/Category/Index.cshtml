@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<section class="py-5 bg-light border-bottom mb-5 text-center">
    <div class="container">
        <span class="badge bg-white text-dark px-3 py-2 rounded-pill shadow-sm mb-2 border">
            🏷️ Lezzet Çeşitleri
        </span>
        <h1 class="fw-bold display-6 mb-2">Kategoriler</h1>
        <p class="text-muted mb-0">Ne pişirmek istediğinize karar verin, en lezzetli tarifleri keşfedin.</p>
    </div>
</section>

<div class="container mb-5">
    <div class="row g-4">
        @foreach (var c in Model)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none">
                    <div class="card category-modern-card h-100 border-0 rounded-4 overflow-hidden shadow-sm">
                        <!-- Kategori Görseli -->
                        <div class="category-img-container">
                            <img src="@c.ImageUrl" alt="@c.Name" class="category-card-img"
                                 onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop&q=80'">
                        </div>
                        
                        <!-- Kategori Adı ve Açıklaması -->
                        <div class="card-body p-4 text-center">
                            <h4 class="fw-bold text-dark mb-2">@c.Name</h4>
                            <p class="text-muted small mb-3 line-clamp-2">
                                @(string.IsNullOrEmpty(c.Description) ? "Lezzetli ve pratik tarifleri inceleyin." : c.Description)
                            </p>
                            <span class="btn btn-sm btn-brand-outline px-3 rounded-pill">
                                Tariflere Göz At →
                            </span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>