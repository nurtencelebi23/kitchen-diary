@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="page-header">
    <h1>Kategoriler</h1>
</div>

<div class="container my-5">
    <div class="row">
        @foreach (var c in Model)
        {
            <div class="col-12 col-md-4 mb-4">
                <a asp-action="Details" asp-route-id="@c.Id" class="text-decoration-none">
                    <div class="card category-card shadow-sm">
                        <img src="@c.ImageUrl" class="card-img-top" alt="@c.Name"
                             onerror="this.src='https://placehold.co/600x400?text=Kategori'">
                        <div class="card-body text-center">
                            <h5 class="text-dark">@c.Name</h5>
                            <small class="text-muted">@c.Description</small>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>